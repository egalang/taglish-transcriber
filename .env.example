# Copy to .env and fill in. .env is gitignored and excluded from the image.

# OpenCode Go API key (starts with sk-). Used for the cleanup pass.
OPENCODE_API_KEY=sk-your-key-here
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4.1-flash
# "none" disables the model's reasoning pass (faster/cheaper, enough for cleanup).
OPENCODE_REASONING_EFFORT=none

# Optional: Hugging Face token, speeds up / authenticates Whisper weight downloads.
HF_TOKEN=

# Transcription defaults (can also be changed per-run in the UI).
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
